const fs = require('fs');

async function sendTelegramQuote() {
    // 1. Preluăm datele secrete din mediul GitHub Actions
    const token = process.env.TELEGRAM_BOT_TOKEN;
    const chatId = process.env.TELEGRAM_CHAT_ID;

    if (!token || !chatId) {
        console.error("Lipsește TELEGRAM_BOT_TOKEN sau TELEGRAM_CHAT_ID!");
        process.exit(1);
    }

    // 2. Citim baza de date cu citate
    const quotesData = JSON.parse(fs.readFileSync('quotes.json', 'utf8'));
    
    // Folosim o logică simplă bazată pe zi sau pe un index rotativ (sau luat aleatoriu)
    const totalQuotes = quotesData.length;
    const randomIndex = Math.floor(Math.random() * totalQuotes);
    const selected = quotesData[randomIndex];

    // 3. Formatăm mesajul pentru Telegram
    const message = `✨ *Citatul Zilei*\n\n> "${selected.quote}"\n\n— *${selected.author}*`;

    // 4. Trimitem mesajul prin API-ul oficial Telegram
    const url = `https://api.telegram.org/bot${token}/sendMessage`;
    
    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                chat_id: chatId,
                text: message,
                parse_mode: 'Markdown'
            })
        });

        const data = await response.json();
        if (!data.ok) {
            throw new Error(`Eroare Telegram: ${JSON.stringify(data)}`);
        }

        console.log("Citatul a fost trimis cu succes pe Telegram!");
    } catch (error) {
        console.error("Eroare la trimiterea pe Telegram:", error);
        process.exit(1);
    }
}

sendTelegramQuote();

const fs = require('fs');

async function sendTelegramQuote() {
    const token = (process.env.MY_TELEGRAM_TOKEN || '').trim();
    const chatId = (process.env.TELEGRAM_CHAT_ID || '').trim();

    console.log("Token lungime:", token.length);
    console.log("Chat ID lungime:", chatId.length);

    if (!token || !chatId) {
        console.error("Lipsește tokenul sau chat ID-ul din mediul de execuție!");
        process.exit(1);
    }

    const quotesData = JSON.parse(fs.readFileSync('quotes.json', 'utf8'));
    const totalQuotes = quotesData.length;
    const randomIndex = Math.floor(Math.random() * totalQuotes);
    const selected = quotesData[randomIndex];

    const message = `✨ *Citatul Zilei*\n\n> "${selected.quote}"\n\n— *${selected.author}*`;

    const url = `https://api.telegram.org/bot${token}/sendMessage`;
    
    try {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                chat_id: chatId,
                text: message,
                parse_mode: 'Markdown'
            })
        });

        const data = await response.json();
        if (!data.ok) {
            throw new Error(`Eroare Telegram: ${JSON.stringify(data)}`);
        }

        console.log("Citatul a fost trimis cu succes pe Telegram!");
    } catch (error) {
        console.error("Eroare la trimiterea pe Telegram:", error);
        process.exit(1);
    }
}

sendTelegramQuote();
